<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" 
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  
  <!-- Parent Reference -->
  <parent>
    <groupId>org.acmsl.javaeda</groupId>
    <artifactId>eda-base</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../base</relativePath>
  </parent>

  <groupId>org.acmsl.javaeda</groupId>
  <artifactId>eda-domain</artifactId>
  <version>0.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  
  <name>JavaEDA Domain</name>
  <description>Support for domains using Java-EDA</description>
  <url>https://github.com/java-eda/domain</url>
  <inceptionYear>2025</inceptionYear>
  
  <organization>
    <name>ACM-SL</name>
    <url>http://www.acm-sl.org</url>
  </organization>
  
  <licenses>
    <license>
      <name>GNU General Public License v3.0</name>
      <url>https://www.gnu.org/licenses/gpl-3.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  
  <developers>
    <developer>
      <name>José San Leandro</name>
      <email>rydnr@acm-sl.org</email>
      <url>https://github.com/rydnr</url>
    </developer>
  </developers>
  
  <scm>
    <connection>scm:git:https://github.com/java-eda/domain.git</connection>
    <developerConnection>scm:git:git@github.com:java-eda/domain.git</developerConnection>
    <url>https://github.com/java-eda/domain</url>
  </scm>
  
  <issueManagement>
    <system>github</system>
    <url>https://github.com/java-eda/domain/issues</url>
  </issueManagement>
  
  <!-- Properties -->
  <properties>
    <!-- Enforce no infrastructure dependencies in domain -->
    <maven.enforcer.fail>true</maven.enforcer.fail>
  </properties>

  <!-- STRICT DEPENDENCIES - Only EDA-annotations Lombok + Testing -->
  <dependencies>
    <dependency>
      <groupId>org.acmsl.javaeda</groupId>
      <artifactId>eda-annotations</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.checkerframework</groupId>
      <artifactId>checker</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.github.f4b6a3</groupId>
      <artifactId>uuid-creator</artifactId>
    </dependency>
    <dependency>
      <groupId>com.google.auto.service</groupId>
      <artifactId>auto-service-annotations</artifactId>
    </dependency>

    <!-- Jakarta Validation API (for domain constraints) -->
    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.aspectj</groupId>
      <artifactId>aspectjrt</artifactId>
    </dependency>
    <dependency>
      <groupId>org.aspectj</groupId>
      <artifactId>aspectjweaver</artifactId>
    </dependency>

    <!-- ========== TESTING DEPENDENCIES ========== -->

    <!-- JUnit 5 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- AssertJ for fluent assertions -->
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Mockito for mocking -->
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Mockito JUnit Jupiter integration -->
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- ArchUnit for architecture testing -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Property-based testing with jqwik -->
    <dependency>
      <groupId>net.jqwik</groupId>
      <artifactId>jqwik</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Test fixtures and builders -->
    <dependency>
      <groupId>com.github.javafaker</groupId>
      <artifactId>javafaker</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <!-- Build Configuration -->
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.acmsl.javaeda</groupId>
              <artifactId>eda-annotations</artifactId>
              <version>0.0.0-SNAPSHOT</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>aspectj-maven-plugin</artifactId>
        <configuration>
          <complianceLevel>16</complianceLevel> <!-- max allowed so far -->
          <source>16</source> <!-- max allowed so far -->
          <target>16</target> <!-- max allowed so far -->
          <aspectLibraries>
            <aspectLibrary>
              <groupId>org.acmsl.javaeda</groupId>
              <artifactId>eda-annotations</artifactId>
            </aspectLibrary>
          </aspectLibraries>
        </configuration>
        <executions>
          <execution>
            <phase>process-classes</phase>
            <goals>
              <goal>compile</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Enforcer Plugin - CRITICAL for maintaining boundaries -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-domain-boundaries</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <!-- Ban infrastructure dependencies -->
                <bannedDependencies>
                  <excludes>
                    <!-- No Spring Framework -->
                    <exclude>org.springframework:*</exclude>
                    <exclude>org.springframework.boot:*</exclude>
                    <exclude>org.springframework.data:*</exclude>

                    <!-- No Database drivers/ORMs -->
                    <exclude>org.hibernate:*</exclude>
                    <exclude>jakarta.persistence:*</exclude>
                    <exclude>org.postgresql:*</exclude>
                    <exclude>mysql:*</exclude>
                    <exclude>com.h2database:*</exclude>

                    <!-- No HTTP/Web frameworks -->
                    <exclude>org.apache.httpcomponents:*</exclude>
                    <exclude>com.fasterxml.jackson.core:*</exclude>
                    <exclude>jakarta.servlet:*</exclude>

                    <!-- No messaging systems -->
                    <exclude>org.apache.kafka:*</exclude>
                    <exclude>org.springframework.amqp:*</exclude>
                    <exclude>com.rabbitmq:*</exclude>

                    <!-- No external service clients -->
                    <exclude>software.amazon.awssdk:*</exclude>
                    <exclude>com.azure:*</exclude>
                    <exclude>com.google.cloud:*</exclude>
                  </excludes>
                  <includes>
                    <!-- Allow only these specific patterns -->
                    <include>org.projectlombok:lombok:*:*:provided</include>
                    <include>jakarta.validation:jakarta.validation-api</include>
                    <include>com.google.code.findbugs:jsr305</include>
                    <include>*:*:*:*:test</include> <!-- All test dependencies allowed -->
                  </includes>
                  <message>
                    🚫 DOMAIN BOUNDARY VIOLATION!
                    Domain layer can only depend on:
                    - Lombok (provided scope)
                    - Jakarta Validation API
                    - JSR-305 annotations
                    - Testing frameworks (test scope)

                    Found prohibited dependency. Keep the domain pure! 🎯
                  </message>
                </bannedDependencies>

                <!-- Require specific Java version -->
                <requireJavaVersion>
                  <version>[${maven.compiler.source},)</version>
                  <message>Domain module requires Java ${maven.compiler.source} or higher</message>
                </requireJavaVersion>

                <!-- Require Maven version -->
                <requireMavenVersion>
                  <version>[3.8.0,)</version>
                  <message>Domain module requires Maven 3.8.0 or higher</message>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- JaCoCo for code coverage -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jxr-plugin</artifactId>
      </plugin>

      <!-- PMD for code quality -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <!-- Reporting for domain metrics -->
  <reporting>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
      </plugin>
    </plugins>
  </reporting>
</project>
