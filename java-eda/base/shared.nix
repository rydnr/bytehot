  shellHook-for = { jdk, maven, nixpkgsRelease, package }: ''
    export PNAME="${package.pname}";
    export PVERSION="${package.version}";
    export JDKVERSION="${jdk.name}";
    export MAVENVERSION="${maven.name}";
    export NIXPKGSRELEASE="${nixpkgsRelease}";
    export PATH="${maven}/bin:${jdk}/bin:$PATH";
    export PS1="\033[37m[\[\033[01;33m\]\$PNAME-\$PVERSION\033[01;37m|\033[01;32m\]\$JDKVERSION\]\033[37m|\[\033[00m\]\[\033[01;34m\]\W\033[37m]\033[31m\$\[\033[00m\] ";
    bs='\\'
    echo;
    echo -e "\033[36m _ .-') _    _   .-')            \033[36m  ) (\`-.       \033[36m    _ (\`-.              \033[36m  ('-.      .-') _                             \033[36m _  .-')    _   .-')\033[0m"
    echo -e "\033[36m( (  \033[31mOO\033[36m) )  ( '.( \033[31mOO\033[36m )_          \033[36m   ( \033[31mOO\033[36m ).     \033[36m   ( (\033[31mOO\033[36m  )             \033[36m ( \033[31mOO\033[36m ).-. (  \033[31mOO\033[36m) )                           \033[36m ( \\( \033[31m-O\033[36m )  ( '.( \033[31mOO\033[36m )_\033[0m"
    echo -e "\033[36m \\     .'_   \033[35m,--.   ,--.\033[36m)  \033[35m,-.\033[36m-')  (/.  \\_)-.  \033[36m  _.\`     \\   \033[34m,--.       \033[36m / .\033[34m --. \033[36m/ /     '._    \033[34m ,------. \033[36m .-'),\033[34m-----.  ,------.   ,--.   ,--\033[36m.)\033[0m"
    echo -e "\033[36m ,\`'--..._)  \033[35m|   \`.'   |  \033[35m |  |\033[31mOO\033[36m) \033[35m \\  \`.'  /   \033[36m (_...--' |  \033[34m|  |\033[36m.-')    | -\033[34m-.  \\  |\033[36m'--...__) ('-\033[34m| \033[36m_\033[34m.---' \033[36m( \033[31mOO\033[36m'\033[34m  .-.  ' |   /\`. '  |   \`.'   |\033[0m"
    echo -e "\033[35m |  |  \\  '  |         |   |  |\033[36m  \\ \033[35m  \\     /\033[36m\\     \033[34m|  /  | |  |  |\033[36m \033[31mOO\033[36m ) .-'-' \033[34m |  | '--.  .--' \033[36m(\033[31mOO\033[36m|(\\ \033[34m     \033[36m/   \033[34m|  | |  | |  /  | |  |         |\033[0m"
    echo -e "\033[35m |  |   ' |  |  |'.'|  |   |  |\033[36m(_/ \033[35m   \\   \\ \033[36m|     \033[34m|  |_.' |  |  |\033[36m\`-' | \_\033[34m| |_.'  |    |  |   \033[36m/   \033[34m|  '--. \033[36m \\_) \033[34m|  |\033[36m$bs\033[34m|  | |  |_.' |  |  |'.'|  |\033[0m"
    echo -e "\033[35m |  |   / :  |  |   |  | \033[36m ,\033[35m|  |\033[36m_.' \033[35m  .'    \\ \033[36m_)   \033[34m|  .___.'\033[36m (\033[34m|  '---.\033[36m' \033[34m  |  .-.  |    |  |   \033[36m \\_)\033[34m|  .--' \033[36m   \\ \033[34m|  | |  | |  .  '.'  |  |   |  |\033[0m"
    echo -e "\033[35m |  '--'  /  |  |   |  | \033[36m(_\033[35m|  |     /  .'.  \\     \033[34m|  |       |      |    |  | |  |    |  |       \033[36m$bs\033[34m|  |\033[36m_)     \`\033[34m'  '-'  ' |  |\\  \\   |  |   |  |\033[0m"
    echo -e "\033[35m \`-------'   \`--'   \`--'   \`--'    '--'   '--'    \033[34m\`--'       \`------'    \`--' \`--'    \`--'       \`--'          \`-----'  \`--' '--'  \`--'   \`--'\033[0m"
    echo;
    echo -e "\033[32m$PNAME-$PVERSION\033[0m on \033[34m$JDKVERSION, \033[35m$MAVENVERSION\033[0";
    echo;
  '';
  devShell-for = { jdk, maven, nixpkgsRelease, package, pkgs}:
    pkgs.mkShell {
      buildInputs = [ package ];
      shellHook = shellHook-for { inherit jdk maven nixpkgsRelease package ; };
    };
  app-for = { entrypoint, jdk, package }: {
    type = "app";
    program = "${jdk}/bin/java -jar ${package}/target/${entrypoint}";
  };
}
